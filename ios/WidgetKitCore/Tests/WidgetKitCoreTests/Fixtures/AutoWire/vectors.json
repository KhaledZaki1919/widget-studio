[
 {
  "name": "music card: fields, static bar, transport row under one open.app button",
  "spec": {
   "schemaVersion": 1,
   "id": "v.music",
   "name": {
    "en": "Music Player",
    "ar": "Music Player"
   },
   "family": "medium",
   "background": {
    "type": "solid",
    "color": "#111111"
   },
   "fields": [
    {
     "key": "title",
     "type": "text",
     "label": {
      "en": "Song",
      "ar": "Song"
     },
     "default": {
      "en": "Blinding Lights",
      "ar": "Blinding Lights"
     }
    },
    {
     "key": "artist",
     "type": "text",
     "label": {
      "en": "Artist",
      "ar": "Artist"
     },
     "default": {
      "en": "The Weekend",
      "ar": "The Weekend"
     }
    },
    {
     "key": "length",
     "type": "text",
     "label": {
      "en": "Length",
      "ar": "Length"
     },
     "default": {
      "en": "4:23",
      "ar": "4:23"
     }
    }
   ],
   "layers": [
    {
     "type": "stack",
     "axis": "vertical",
     "frame": {
      "x": 16,
      "y": 38,
      "w": 270,
      "h": 42
     },
     "children": [
      {
       "type": "text",
       "value": {
        "en": "{{field.title}}",
        "ar": "{{field.title}}"
       },
       "font": {
        "family": "system",
        "size": 17
       },
       "color": "#FFFFFF"
      },
      {
       "type": "text",
       "value": {
        "en": "{{field.artist}}",
        "ar": "{{field.artist}}"
       },
       "font": {
        "family": "system",
        "size": 12
       },
       "color": "#FFFFFF"
      }
     ]
    },
    {
     "type": "stack",
     "axis": "vertical",
     "frame": {
      "x": 296,
      "y": 64,
      "w": 52,
      "h": 16
     },
     "children": [
      {
       "type": "text",
       "value": {
        "en": "{{field.length}}",
        "ar": "{{field.length}}"
       },
       "font": {
        "family": "system",
        "size": 11
       },
       "color": "#FFFFFF"
      }
     ]
    },
    {
     "type": "progressBar",
     "progress": "0.4",
     "color": "#FFFFFF",
     "trackColor": "#3A3A3A",
     "segments": 20,
     "frame": {
      "x": 16,
      "y": 86,
      "w": 332,
      "h": 8
     }
    },
    {
     "type": "stack",
     "axis": "horizontal",
     "frame": {
      "x": 232,
      "y": 112,
      "w": 116,
      "h": 40
     },
     "children": [
      {
       "type": "text",
       "value": {
        "en": "⏮︎",
        "ar": "⏮︎"
       },
       "font": {
        "family": "system",
        "size": 16
       },
       "color": "#FFFFFF"
      },
      {
       "type": "icon",
       "symbol": "pause.fill",
       "size": 18,
       "color": "#FFFFFF"
      },
      {
       "type": "text",
       "value": {
        "en": "⏭︎",
        "ar": "⏭︎"
       },
       "font": {
        "family": "system",
        "size": 16
       },
       "color": "#FFFFFF"
      }
     ],
     "spacing": 22,
     "justify": "end"
    },
    {
     "type": "button",
     "action": "open.app",
     "frame": {
      "x": 232,
      "y": 112,
      "w": 116,
      "h": 40
     }
    }
   ]
  },
  "wired": [
   "media.title",
   "media.artist",
   "media.duration",
   "media.progress",
   "media.symbol",
   "media.playPause",
   "media.next",
   "media.previous"
  ],
  "notWired": [
   "open.app",
   "field.title"
  ]
 },
