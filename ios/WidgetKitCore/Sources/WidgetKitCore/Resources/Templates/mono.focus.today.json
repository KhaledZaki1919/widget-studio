{
  "schemaVersion": 1,
  "id": "mono.focus.today",
  "category": "countdown",
  "name": { "en": "Focus Today", "ar": "تركيز اليوم" },
  "family": "small",
  "theme": "dark",
  "refresh": "hourly",
  "background": { "type": "solid", "color": "@bg" },
  "layers": [
    { "type": "dotBars", "bars": 7, "maxDots": 4, "values": "{{focus.week}}", "color": "@accent", "offColor": "@dim", "frame": { "x": 16, "y": 16, "w": 138, "h": 40 }, "mirror": true },
    { "type": "text", "value": "{{focus.today}}", "font": { "family": "dot", "size": 32, "weight": "bold" }, "color": "@fg", "frame": { "x": 14, "y": 82, "w": 142, "h": 42 }, "mirror": true },
    { "type": "text", "value": { "en": "TOTAL TIME", "ar": "إجمالي الوقت" }, "font": { "family": "system", "size": 9, "weight": "semibold" }, "tracking": 1, "color": "@muted", "frame": { "x": 16, "y": 128, "w": 138, "h": 12 }, "mirror": true }
  ]
}
