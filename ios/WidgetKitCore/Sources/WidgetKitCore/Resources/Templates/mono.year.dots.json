{
 "schemaVersion": 1,
 "id": "mono.year.dots",
 "category": "time",
 "name": {
  "en": "Year Dots",
  "ar": "نقاط السنة"
 },
 "family": "small",
 "theme": "dark",
 "refresh": "hourly",
