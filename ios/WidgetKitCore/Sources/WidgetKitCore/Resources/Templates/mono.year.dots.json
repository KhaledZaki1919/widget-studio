   "frame": {
    "x": 21,
    "y": 44,
    "w": 127,
    "h": 88
   }
  },
  {
   "type": "text",
   "value": {
    "en": "{{year.daysLeft}} days left",
    "ar": "متبقي {{year.daysLeft}} يومًا"
   },
   "font": {
    "family": "system",
    "size": 11,
    "weight": "medium"
   },
   "color": "@muted",
   "frame": {
    "x": 16,
    "y": 142,
    "w": 138,
    "h": 16
   },
   "mirror": true
  }
 ]
}
