{
  "schemaVersion": 1,
  "id": "mono.qibla",
  "category": "prayer",
  "name": { "en": "Qibla", "ar": "القبلة" },
  "family": "small",
  "theme": "dark",
  "refresh": "hourly",
  "background": { "type": "solid", "color": "@bg", "outerColor": "@outer" },
  "layers": [
    { "type": "shape", "kind": "circle", "stroke": { "color": "@line", "width": 1.5, "dash": [2, 6] }, "frame": { "x": 22, "y": 22, "w": 126, "h": 126 } },
    { "type": "text", "value": { "en": "N", "ar": "ش" }, "font": { "family": "dot", "size": 13, "weight": "bold" }, "color": "@accent", "align": "center", "frame": { "x": 75, "y": 12, "w": 20, "h": 16 } },
    { "type": "icon", "symbol": "location.north.fill", "size": 40, "color": "@fg", "rotation": "{{qibla.bearing}}", "frame": { "x": 55, "y": 45, "w": 60, "h": 60 } },
    { "type": "text", "value": "{{qibla.bearing}}°", "font": { "family": "dot", "size": 18, "weight": "bold" }, "color": "@fg", "align": "center", "frame": { "x": 35, "y": 110, "w": 100, "h": 24 } },
    { "type": "text", "value": { "en": "QIBLA", "ar": "القبلة" }, "font": { "family": "system", "size": 8, "weight": "semibold" }, "tracking": 1, "color": "@muted", "align": "center", "frame": { "x": 35, "y": 134, "w": 100, "h": 12 } }
  ]
}
