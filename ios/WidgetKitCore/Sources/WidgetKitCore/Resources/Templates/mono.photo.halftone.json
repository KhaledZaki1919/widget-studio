{
  "schemaVersion": 1,
  "id": "mono.photo.halftone",
  "category": "photo",
  "name": { "en": "Dot Portrait", "ar": "صورة منقّطة" },
  "family": "small",
  "theme": "light",
  "refresh": "none",
  "background": { "type": "solid", "color": "@bg" },
  "fields": [
    { "key": "photo", "type": "image", "label": { "en": "Photo", "ar": "الصورة" } }
  ],
  "layers": [
    { "type": "image", "source": "user_image", "fit": "fill", "mask": "rect", "filter": "halftone", "frame": { "x": 0, "y": 0, "w": 170, "h": 170 } },
    { "type": "shape", "kind": "circle", "fill": "@fg", "frame": { "x": 128, "y": 128, "w": 30, "h": 30 }, "mirror": true },
    { "type": "icon", "symbol": "music.note", "size": 12, "color": "@bg", "frame": { "x": 128, "y": 128, "w": 30, "h": 30 }, "mirror": true }
  ]
}
