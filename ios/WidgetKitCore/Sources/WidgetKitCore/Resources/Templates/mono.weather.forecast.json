{
  "schemaVersion": 1,
  "id": "mono.weather.forecast",
  "category": "weather",
  "name": { "en": "Forecast", "ar": "توقعات" },
  "family": "medium",
  "theme": "dark",
  "refresh": "hourly",
  "background": { "type": "solid", "color": "@bg" },
  "fields": [
    { "key": "city", "type": "city", "label": { "en": "City", "ar": "المدينة" }, "default": { "en": "Cairo", "ar": "القاهرة" } }
  ],
  "layers": [
    { "type": "icon", "symbol": "{{weather.symbol}}", "size": 24, "color": "@fg", "frame": { "x": 14, "y": 12, "w": 34, "h": 34 }, "mirror": true },
    { "type": "text", "value": "{{weather.temp}}°", "font": { "family": "dot", "size": 32, "weight": "bold" }, "color": "@fg", "frame": { "x": 56, "y": 8, "w": 100, "h": 40 }, "mirror": true },
    { "type": "text", "value": { "en": "H {{weather.hi}}°  L {{weather.lo}}°", "ar": "ع {{weather.hi}}°  ص {{weather.lo}}°" }, "font": { "family": "system", "size": 10, "weight": "medium" }, "color": "@muted", "frame": { "x": 16, "y": 48, "w": 150, "h": 14 }, "mirror": true },
    { "type": "text", "value": "{{field.city}}", "font": { "family": "system", "size": 13, "weight": "semibold" }, "color": "@fg", "align": "trailing", "frame": { "x": 190, "y": 14, "w": 158, "h": 18 }, "mirror": true },
    { "type": "text", "value": "{{weather.cond}}", "font": { "family": "system", "size": 11 }, "color": "@muted", "align": "trailing", "frame": { "x": 190, "y": 33, "w": 158, "h": 14 }, "mirror": true },
    { "type": "forecastRow", "days": 6, "color": "@fg", "frame": { "x": 12, "y": 72, "w": 340, "h": 86 }, "mirror": true }
  ]
}
