{
 "schemaVersion": 1,
 "id": "mono.music.card",
 "category": "photo",
 "name": {
  "en": "Music Card",
  "ar": "بطاقة موسيقى"
 },
 "family": "small",
 "theme": "dark",
 "refresh": "minute",
 "background": {
  "type": "solid",
  "color": "@bg"
 },
 "fields": [],
 "layers": [
  {
   "type": "image",
   "source": "{{media.artwork}}",
   "fit": "fill",
   "mask": "roundedRect",
   "cornerRadius": 12,
   "frame": {
    "x": 14,
    "y": 14,
    "w": 74,
    "h": 74
   },
   "mirror": true
  },
  {
   "type": "shape",
   "kind": "circle",
   "fill": "@accent",
   "frame": {
    "x": 120,
    "y": 14,
    "w": 36,
    "h": 36
   },
   "mirror": true
  },
  {
   "type": "icon",
   "symbol": "{{media.symbol}}",
   "size": 13,
   "color": "@onAccent",
   "frame": {
    "x": 120,
    "y": 14,
    "w": 36,
    "h": 36
   },
   "mirror": true
  },
  {
   "type": "text",
   "value": "{{media.title}}",
   "font": {
    "family": "system",
    "size": 14,
    "weight": "semibold"
   },
   "color": "@fg",
   "frame": {
    "x": 16,
    "y": 104,
    "w": 138,
    "h": 20
   },
   "mirror": true,
   "maxLines": 1
  },
  {
   "type": "text",
   "value": "{{media.artist}}",
   "font": {
    "family": "system",
    "size": 11
   },
   "color": "@muted",
   "frame": {
    "x": 16,
    "y": 126,
    "w": 138,
    "h": 16
   },
   "mirror": true,
   "maxLines": 1
  },
  {
   "type": "button",
   "action": "media.open",
   "frame": {
    "x": 0,
    "y": 0,
    "w": 170,
    "h": 170
   }
  },
  {
   "type": "button",
   "action": "media.playPause",
   "frame": {
    "x": 114,
    "y": 8,
    "w": 48,
    "h": 48
   },
   "mirror": true
  }
 ]
}
