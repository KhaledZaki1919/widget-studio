{
  "schemaVersion": 1,
  "id": "test.clock.world",
  "name": { "en": "World clocks", "ar": "ساعات العالم" },
  "family": "large",
  "theme": "dark",
  "refresh": "minute",
  "background": { "type": "gradient", "colors": ["#1A1A1A", "#0E0E0E"], "angle": 90 },
  "fields": [
    { "key": "zone1", "type": "timezone", "label": { "en": "First city", "ar": "المدينة الأولى" }, "default": "Africa/Cairo" },
    { "key": "zone2", "type": "timezone", "label": { "en": "Second city", "ar": "المدينة الثانية" }, "default": "Europe/London" },
    { "key": "zone3", "type": "timezone", "label": { "en": "Third city", "ar": "المدينة الثالثة" }, "default": "Asia/Dubai" }
  ],
  "layers": [
    { "type": "analogClock", "style": "dot", "faceColor": "#262626", "tickColor": "#FFFFFF", "hourColor": "#FFFFFF", "minuteColor": "#FFFFFF", "accentColor": "#E31C24", "timezone": "{{field.zone1}}", "frame": { "x": 16, "y": 16, "w": 100, "h": 100 } },
    { "type": "analogClock", "style": "dot", "faceColor": "#262626", "tickColor": "#FFFFFF", "hourColor": "#FFFFFF", "minuteColor": "#FFFFFF", "accentColor": "#E31C24", "timezone": "{{field.zone2}}", "frame": { "x": 132, "y": 16, "w": 100, "h": 100 } },
    { "type": "analogClock", "style": "dot", "faceColor": "#262626", "tickColor": "#FFFFFF", "hourColor": "#FFFFFF", "minuteColor": "#FFFFFF", "accentColor": "#E31C24", "timezone": "{{field.zone3}}", "frame": { "x": 248, "y": 16, "w": 100, "h": 100 } },
    { "type": "text", "value": "{{tz.zone1.time}}", "font": { "family": "dot", "size": 18, "weight": "bold" }, "color": "#FFFFFF", "align": "center", "frame": { "x": 16, "y": 124, "w": 100, "h": 22 } },
    { "type": "text", "value": "{{tz.zone2.time}}", "font": { "family": "dot", "size": 18, "weight": "bold" }, "color": "#FFFFFF", "align": "center", "frame": { "x": 132, "y": 124, "w": 100, "h": 22 } },
    { "type": "text", "value": "{{tz.zone3.time}}", "font": { "family": "dot", "size": 18, "weight": "bold" }, "color": "#FFFFFF", "align": "center", "frame": { "x": 248, "y": 124, "w": 100, "h": 22 } },
    { "type": "text", "value": { "en": "Cairo", "ar": "القاهرة" }, "font": { "family": "system", "size": 11 }, "color": "#FFFFFF99", "align": "center", "frame": { "x": 16, "y": 148, "w": 100, "h": 16 } },
    { "type": "text", "value": { "en": "London", "ar": "لندن" }, "font": { "family": "system", "size": 11 }, "color": "#FFFFFF99", "align": "center", "frame": { "x": 132, "y": 148, "w": 100, "h": 16 } },
    { "type": "text", "value": { "en": "Dubai", "ar": "دبي" }, "font": { "family": "system", "size": 11 }, "color": "#FFFFFF99", "align": "center", "frame": { "x": 248, "y": 148, "w": 100, "h": 16 } },
    { "type": "shape", "kind": "rect", "fill": "#FFFFFF1F", "frame": { "x": 16, "y": 182, "w": 332, "h": 1 } },
    { "type": "text", "value": { "en": "STEPS THIS MONTH", "ar": "خطوات هذا الشهر" }, "font": { "family": "system", "size": 10, "weight": "semibold" }, "tracking": 1, "color": "#FFFFFF99", "frame": { "x": 16, "y": 200, "w": 140, "h": 14 }, "mirror": true },
    { "type": "text", "value": "{{date.MMM}}", "font": { "family": "dot", "size": 22, "weight": "bold" }, "color": "#E31C24", "frame": { "x": 16, "y": 222, "w": 140, "h": 28 }, "mirror": true },
    { "type": "text", "value": { "en": "TODAY", "ar": "اليوم" }, "font": { "family": "system", "size": 10, "weight": "semibold" }, "tracking": 1, "color": "#FFFFFF99", "frame": { "x": 16, "y": 300, "w": 140, "h": 14 }, "mirror": true },
    { "type": "text", "value": "{{steps.today}}", "font": { "family": "dot", "size": 30, "weight": "bold" }, "color": "#FFFFFF", "frame": { "x": 14, "y": 318, "w": 142, "h": 38 }, "mirror": true },
    { "type": "dotGrid", "rows": 6, "cols": 7, "dotSize": 18, "gap": 7, "onColor": "#FFFFFF", "offColor": "#FFFFFF1A", "values": "{{steps.monthGrid}}", "frame": { "x": 172, "y": 198, "w": 176, "h": 168 }, "mirror": true }
  ]
}
