{
  "schemaVersion": 1,
  "id": "test.health.sleep",
  "name": { "en": "Sleep week", "ar": "نوم الأسبوع" },
  "family": "medium",
  "theme": "dark",
  "refresh": "daily",
  "background": { "type": "solid", "color": "#0E0E0E" },
