{
  "sourceLanguage": "ar",
  "strings": {
    "widget.gap.noBattery": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستوى البطارية غير متاح للودجت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The battery level isn't available to the widget."
          }
        }
      }
    },
    "widget.gap.noHealth": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع الودجت قراءة الخطوات والنوم على هذا التثبيت. اسمح بـ «صحتي» في الإعدادات داخل التطبيق؛ وإن استمرت الرسالة فهي تحتاج نسخة App Store."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The widget can't read steps and sleep on this install. Allow Health in the app's Settings; if this stays, it needs the App Store version."
          }
        }
      }
    },
    "widget.gap.noLocation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Widget Studio واسمح بالموقع «أثناء استخدام التطبيق»، ثم يحدد الودجت مكانك بنفسه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Widget Studio and allow location “While Using the App”; the widget then finds your place itself."
          }
        }
      }
    },
    "widget.gap.noWeather": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد طقس بعد. يجلبه الودجت تلقائيًا عند الاتصال بالإنترنت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No weather yet. The widget fetches it by itself when you're online."
          }
        }
      }
    },
    "widget.intent.counter.increment": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسبيحة +١"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count +1"
          }
        }
      }
    },
    "widget.intent.counter.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الذكر التالي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next dhikr"
          }
        }
      }
    },
    "widget.intent.counter.reset": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصفير العداد"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset counter"
          }
        }
      }
    },
    "widget.intent.counter.target": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الهدف"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target"
          }
        }
      }
    },
    "widget.intent.stopwatch.toggle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل أو إيقاف ساعة الإيقاف"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start or stop the stopwatch"
          }
        }
      }
    },
    "widget.mywidget.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض أحدث تصميم حفظته في «ودجتاتي» بهذا المقاس."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows your newest saved design that fits this size."
          }
        }
      }
    },
    "widget.mywidget.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ تصميمًا بهذا المقاس في التطبيق ليظهر هنا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a design of this size in the app to show it here."
          }
        }
      }
    },
    "widget.mywidget.name": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ودجتي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My widget"
          }
        }
      }
    },
    "widget.mywidget.noAppGroup": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التصاميم المحفوظة تظهر هنا في نسخة App Store."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved designs appear here in the App Store version."
          }
        }
      }
    },
