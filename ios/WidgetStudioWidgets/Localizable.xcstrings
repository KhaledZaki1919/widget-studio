      }
    },
    "widget.probe.log.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد سجل بعد. أضف ودجت قالب ثم افتح التشخيص في التطبيق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No log yet. Add a template widget, then open Diagnostics in the app."
          }
        }
      }
    },
