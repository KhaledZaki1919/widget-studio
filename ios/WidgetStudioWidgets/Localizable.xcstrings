    "widget.probe.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتأكد أن الودجت يرى بيانات التطبيق والموقع والبطارية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks that the widget can see app data, location and battery."
          }
        }
      }
    },
