{
  "sourceLanguage": "ar",
  "strings": {
    "widget.mywidget.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض أحدث تصميم حفظته في «ودجتاتي» بهذا المقاس."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows your newest saved design that fits this size."
          }
        }
      }
    },
    "widget.mywidget.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ تصميمًا بهذا المقاس في التطبيق ليظهر هنا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a design of this size in the app to show it here."
          }
        }
      }
    },
    "widget.mywidget.name": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ودجتي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My widget"
          }
        }
      }
    },
    "widget.mywidget.noAppGroup": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التصاميم المحفوظة تظهر هنا في نسخة App Store."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved designs appear here in the App Store version."
          }
        }
      }
    },
