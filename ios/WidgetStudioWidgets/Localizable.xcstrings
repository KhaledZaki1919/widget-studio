          }
        }
      }
    },
    "widget.pick.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر تصميمًا محفوظًا أو قالبًا: اضغط مطولًا ثم «تعديل الودجت»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a saved design or a template: long-press, then Edit Widget."
          }
        }
      }
    },
    "widget.pick.entity": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصميم"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Design"
          }
        }
      }
    },
    "widget.pick.intent.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التصميم أو القالب الذي يعرضه الودجت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The design or template this widget shows."
          }
        }
      }
    },
