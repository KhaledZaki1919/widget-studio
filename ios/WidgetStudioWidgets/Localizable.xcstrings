      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مجموعة مشتركة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No App Group"
