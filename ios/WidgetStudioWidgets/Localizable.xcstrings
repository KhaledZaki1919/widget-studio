{
  "sourceLanguage": "ar",
  "strings": {
    "widget.probe.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتأكد أن الودجت يرى بيانات التطبيق والموقع والبطارية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks that the widget can see app data, location and battery."
          }
        }
      }
    },
    "widget.probe.name": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فحص Widget Studio"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget Studio check"
          }
        }
      }
    },
    "widget.probe.noGroup": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مساحة مشتركة. افتح التطبيق للإعداد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No shared storage. Open the app to set up widgets."
          }
        }
      }
    },
    "widget.probe.openApp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح التطبيق مرة واحدة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app once."
          }
        }
      }
    },
    "widget.probe.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فحص الودجت"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget check"
          }
        }
      }
    },
    "widget.probe.value": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القيمة من التطبيق"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Value from the app"
          }
        }
      }
    }
  },
  "version": "1.0"
