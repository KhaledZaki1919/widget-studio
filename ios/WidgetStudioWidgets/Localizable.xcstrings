    "widget.spec.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض أحد التصاميم التجريبية. اضغط مطولًا ثم «تعديل الودجت» لاختيار تصميم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows one of the test designs. Long-press, then Edit Widget to pick one."
          }
        }
      }
    },
