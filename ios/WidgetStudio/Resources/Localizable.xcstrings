    "detail.fields.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط «تخصيص» لتعديلها وحفظ التصميم في «ودجتاتي»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Customize to edit them and save the design to My widgets."
          }
        }
      }
    },
    "detail.howTo.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على الشاشة الرئيسية ← + ← Widget Studio، ثم اسحب حتى تجد هذا القالب باسمه واضغط «إضافة الودجت»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-press the Home Screen → + → Widget Studio, then swipe to this template (by its name) and tap Add Widget."
          }
        }
      }
    },
    "detail.howTo.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
