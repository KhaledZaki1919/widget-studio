    "diag.widget.none": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد تقرير بعد. أضف الودجت للشاشة الرئيسية ثم اضغط تحديث."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No report yet. Add the widget to your Home Screen, then tap Refresh."
          }
        }
      }
    },
    "diag.widget.notShared": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مساحة مشتركة، فلا يمكن قراءة تقرير الودجت هنا. انظر إلى الودجت نفسه على الشاشة الرئيسية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No shared storage, so the widget's report can't be read here. Look at the widget itself on the Home Screen."
          }
        }
      }
    },
