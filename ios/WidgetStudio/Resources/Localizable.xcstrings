    "diag.share.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل التقرير لنعرف ما يعمل على جهازك. لا يحتوي على مفاتيح أو بيانات صحية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send the report so we know what works on your device. It has no keys and no health data."
          }
        }
      }
    },
