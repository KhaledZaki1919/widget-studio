    "diag.data.footer.storeMode": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون App Group لا يرى التطبيق حالة الودجت. أضف ودجت «فحص Widget Studio» بالمقاس الكبير لترى مصادر الودجت وآخر تحديث لكل منها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without an App Group the app can't see the widget's status. Add the large “Widget Studio check” widget to see each widget source and its last update."
          }
        }
      }
    },
