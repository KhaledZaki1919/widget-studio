    "keyguide.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ المفتاح على جهازك فقط. لا يكلّفك شيئًا ما دمت في الحد المجاني."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key stays on your device. It costs nothing while you stay within the free limit."
          }
        }
      }
    },
    "keyguide.intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج «صمّم من صورة» إلى مفتاح من مزوّد ذكاء اصطناعي. Google تعطيك مفتاح Gemini مجانًا في دقيقتين، ويكفي لنحو ٢٠ تصميمًا في اليوم لكل نموذج."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create from image needs a key from an AI provider. Google gives you a free Gemini key in two minutes; it allows about 20 designs a day per model."
          }
        }
      }
    },
    "keyguide.open": {
      "extractionState": "manual",
