    "diag.data.footer.shared": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التطبيق والودجت يتشاركان البيانات عبر App Group."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app and the widget share data through the App Group."
          }
        }
