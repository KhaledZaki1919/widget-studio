          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the Shortcut's name at the top → Rename, and paste exactly “%@”."
          }
        }
      }
    },
    "tiles.step.search %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط «Add Action» وابحث عن «%@» ثم اختره."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “Add Action”, search for “%@” and choose it."
          }
        }
      }
    },
    "tiles.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS لا يسمح لأي ودجت أو تطبيق بتشغيل الواي فاي أو الكشاف أو الوضع الداكن مباشرة. تطبيق «الاختصارات» من Apple يستطيع ذلك. لذا يشغّل هذا الزر اختصارًا تنشئه مرة واحدة بالاسم أدناه، وبعدها يعمل الزر مباشرة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS doesn't let any widget or app switch Wi-Fi, the torch or Dark Mode directly. Apple's Shortcuts app can. So this tile runs a Shortcut you create once with the name below; after that the tile works directly."
          }
        }
      }
    },
    "tiles.why.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لماذا اختصار؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why a Shortcut?"
          }
        }
      }
    }
  },
  "version": "1.0"
}
