    "detail.sampleData": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المعاينة ببياناتك الحقيقية؛ ما ينقصه إذن (الموقع، الصحة) يظهر «--». فعّله من الإعدادات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previews use your real data; anything that needs permission (location, Health) shows “--”. Turn it on in Settings."
          }
        }
      }
    },
