    "notice.location.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للطقس ومواقيت الصلاة والقبلة. يبقى الموقع على جهازك ولا يُرسل إلا للحصول على الطقس."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For weather, prayer times and the Qibla. Your location stays on your phone and is only sent to get the weather."
          }
        }
