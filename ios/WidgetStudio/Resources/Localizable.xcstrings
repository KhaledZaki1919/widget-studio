        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«الموقَّع» يُقرأ من توقيع الملف التنفيذي نفسه، و«الملف» من ملف التوقيع المرفق. متجر التوقيع (Fast Store) يحدد الاثنين."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Signed” is read from the executable’s own code signature, “Profile” from the embedded provisioning profile. The signing store (Fast Store) decides both."
          }
        }
      }
    },
