    "tasbeeh.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زر ⟳ في الويدجت ينتقل بين الأذكار، ولكل ذكر عدّاده. الهدف من حقل «الهدف» في القالب (٣٣)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ⟳ button in the widget moves between the dhikrs; each keeps its own count. The target comes from the template's Target field (33)."
          }
        }
      }
    },
    "tasbeeh.footer.storeMode": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زر ⟳ في الويدجت ينتقل بين الأذكار، ولكل ذكر عدّاده، والانتقال بعد ٣٣ مفعّل. في هذه النسخة يستخدم الويدجت القائمة الافتراضية؛ تعديل القائمة يصل إليه في وضع المطوّر أو نسخة App Store."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ⟳ button in the widget moves between the dhikrs; each keeps its own count, and moving on after 33 is on. In this version the widget uses the default list; your edited list reaches it in developer mode or the App Store version."
          }
        }
      }
    },
