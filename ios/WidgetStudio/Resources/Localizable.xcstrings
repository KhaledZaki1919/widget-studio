    "tiles.step.option %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الإجراء اضغط الكلمة الزرقاء (On أو Dark) واختر «%@»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the action, tap the blue word (On or Dark) and choose “%@”."
          }
        }
      }
    },
    "tiles.step.rename %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
