    "guide.examples": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أفكار"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideas"
          }
        }
      }
    },
    "guide.examples.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكشاف، الواي فاي، البلوتوث، الوضع الداكن، وضع الطيران، كتم الصوت، تشغيل قائمة موسيقى، إرسال رسالة جاهزة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Torch, Wi-Fi, Bluetooth, Dark Mode, Airplane Mode, Silent mode, play a playlist, send a ready message."
          }
        }
      }
    },
    "guide.intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أزرار الودجت لا تستطيع تشغيل الكشاف أو الواي فاي مباشرة على iOS. بدلًا من ذلك، يفتح الزر التطبيق الذي يشغّل فورًا اختصارًا من تطبيق «الاختصارات» بالاسم الذي كتبته في القالب."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS widgets can't switch the torch or Wi-Fi directly. Instead, a tile opens the app, which immediately runs a Shortcut from the Shortcuts app with the name you set in the template."
          }
        }
      }
    },
    "guide.step1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح تطبيق «الاختصارات» واضغط +."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Shortcuts app and tap +."
          }
        }
      }
    },
    "guide.step2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف إجراءً، مثل «ضبط الكشاف» أو «ضبط الواي فاي»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an action, such as “Set Flashlight” or “Set Wi-Fi”."
          }
        }
      }
    },
    "guide.step3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سمِّ الاختصار، مثلًا «الكشاف»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name the Shortcut, for example “Torch”."
          }
        }
      }
    },
    "guide.step4": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في محرّر Widget Studio اكتب الاسم نفسه تمامًا في حقل «اختصار الزر»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Widget Studio editor, type exactly the same name in the tile's Shortcut field."
          }
        }
      }
    },
    "guide.step5": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط الزر على الشاشة الرئيسية: يفتح التطبيق لحظة ثم يعمل الاختصار."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the tile on the Home Screen: the app opens briefly and the Shortcut runs."
          }
        }
      }
    },
    "guide.steps": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخطوات"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steps"
          }
        }
      }
    },
