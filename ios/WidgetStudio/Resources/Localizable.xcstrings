    "diag.widget.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الودجت يقيس الموقع والبطارية بنفسه عند كل تحديث (كل ١٥ دقيقة تقريبًا، أو عند فتح هذه الشاشة)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The widget measures location and battery itself on every reload (about every 15 minutes, or when this screen opens)."
          }
        }
      }
    },
