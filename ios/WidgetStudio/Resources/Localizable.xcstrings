    "diag.group.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف ودجت «فحص Widget Studio» للشاشة الرئيسية. بعد «كتابة قيمة جديدة» يجب أن يعرض الودجت نفس الرقم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the “Widget Studio check” widget to your Home Screen. After “Write a new value” the widget should show the same number."
          }
        }
      }
    },
