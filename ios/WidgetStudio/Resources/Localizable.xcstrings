{
  "sourceLanguage": "ar",
  "strings": {
    "ai.consent.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسألك قبل أول صورة تُرسل لكل مزوّد. أوقف الموافقة هنا ليسألك التطبيق من جديد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We ask before the first image goes to each provider. Turn a consent off here to be asked again."
          }
        }
      }
    },
    "ai.consent.none": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم توافق على إرسال صور لأي مزوّد بعد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven't allowed any provider to receive images yet."
          }
        }
      }
    },
    "ai.consent.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موافقات إرسال الصور"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image upload consent"
          }
        }
      }
    },
    "ai.diag.copy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخ التفاصيل"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy details"
          }
        }
      }
    },
    "ai.diag.failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed"
          }
        }
      }
    },
    "ai.diag.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي على مفتاحك ولا على صورتك، ويبقى على جهازك. يفيدنا عند الإبلاغ عن مشكلة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No key and no image, and it stays on your device. Useful when reporting a problem."
          }
        }
      }
    },
    "ai.diag.none": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None"
          }
        }
      }
    },
    "ai.diag.success": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نجح"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Succeeded"
          }
        }
      }
    },
    "ai.diag.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "آخر طلب للذكاء الاصطناعي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last AI request"
          }
        }
      }
    },
    "ai.error.badRequest": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض المزوّد الطلب."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider rejected the request."
          }
        }
      }
    },
    "ai.error.badRequest.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب نموذجًا آخر. التفاصيل في الإعدادات ← الذكاء الاصطناعي ← آخر طلب."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try another model. Details are in Settings → AI → Last AI request."
          }
        }
      }
    },
    "ai.error.busy %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ مشغول الآن. حاول مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is busy right now. Try again."
          }
        }
      }
    },
    "ai.error.busy.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الانشغال يكون مؤقتًا عادةً. انتظر دقيقة ثم اضغط «أعد المحاولة»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Busy spells are usually short. Wait a minute, then tap Try again."
          }
        }
      }
    },
    "ai.error.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُلغي الطلب."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled."
          }
        }
      }
    },
    "ai.error.cancelled.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك البدء من جديد متى شئت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can start again any time."
          }
        }
      }
    },
    "ai.error.credit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد رصيد كافٍ في حسابك لدى المزوّد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account with the provider is out of credit."
          }
        }
      }
    },
    "ai.error.credit.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف رصيدًا من صفحة الفوترة لدى المزوّد، أو استخدم مفتاح Gemini مجانيًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add credit on the provider's billing page, or use a free Gemini key."
          }
        }
      }
    },
    "ai.error.dailyQuota": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت طلبات اليوم المجانية لهذا النموذج."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have used today's free requests for this model."
          }
        }
      }
    },
    "ai.error.dailyQuota.next %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاول غدًا، أو اختر نموذجًا آخر من الإعدادات ← الذكاء الاصطناعي (مثل %@)، فلكل نموذج حده اليومي."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again tomorrow, or pick another model in Settings → AI (for example %@): each model has its own daily limit."
          }
        }
      }
    },
    "ai.error.invalidKey": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض المزوّد المفتاح."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider rejected the key."
          }
        }
      }
    },
    "ai.error.invalidKey.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انسخ المفتاح من جديد من صفحة المزوّد، وتأكد أنه للمزوّد المختار."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy the key again from the provider's page and check that it belongs to the selected provider."
          }
        }
      }
    },
    "ai.error.invalidOutput": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُنتج النموذج ويدجت صالحًا حتى بعد إعادة المحاولة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model didn't produce a valid widget, even after a retry."
          }
        }
      }
    },
    "ai.error.invalidOutput.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط «أعد المحاولة»، أو جرّب نموذجًا أقوى أو صورة أوضح."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Try again, or try a stronger model or a clearer image."
          }
        }
      }
    },
    "ai.error.model": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النموذج المختار غير متاح لمفتاحك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected model isn't available for your key."
          }
        }
      }
    },
    "ai.error.model.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر نموذجًا آخر من الإعدادات ← الذكاء الاصطناعي ← النموذج."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick another model in Settings → AI → Model."
          }
        }
      }
    },
    "ai.error.network": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد اتصال بالإنترنت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet connection."
          }
        }
      }
    },
    "ai.error.network.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من الاتصال ثم أعد المحاولة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection and try again."
          }
        }
      }
    },
    "ai.error.noKey": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تضف مفتاح API بعد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No API key yet."
          }
        }
      }
    },
    "ai.error.noKey.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الإعدادات ← الذكاء الاصطناعي والصق مفتاحك. مفتاح Gemini المجاني يكفي."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings → AI and paste your key. A free Gemini key is enough."
          }
        }
      }
    },
    "ai.error.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلت لحد الطلبات المسموح به الآن."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've hit the request limit for now."
          }
        }
      }
    },
    "ai.error.rateLimited.next %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا شائع مع مفتاح Gemini المجاني. انتظر دقيقة ثم أعد المحاولة، أو جرّب النموذج %@ من الإعدادات ← الذكاء الاصطناعي."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is common with a free Gemini key. Wait a minute and try again, or try the model %@ in Settings → AI."
          }
        }
      }
    },
    "ai.error.refused": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض المزوّد هذه الصورة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider declined this image."
          }
        }
      }
    },
    "ai.error.refused.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب صورة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a different image."
          }
        }
      }
    },
    "ai.error.timedOut": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت المهلة قبل وصول الرد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No answer in time."
          }
        }
      }
    },
    "ai.error.timedOut.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد المحاولة، أو اختر نموذجًا أسرع."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again, or choose a faster model."
          }
        }
      }
    },
    "ai.error.truncated": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع الرد قبل أن يكتمل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The answer was cut off."
          }
        }
      }
    },
    "ai.error.truncated.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط «أعد المحاولة»، أو اختر حجمًا أصغر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Try again, or choose a smaller size."
          }
        }
      }
    },
    "ai.error.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة المزوّد مشغولة أو متوقفة الآن."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider's service is busy or down right now."
          }
        }
      }
    },
    "ai.error.unavailable.next": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتظر قليلًا ثم أعد المحاولة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait a little and try again."
          }
        }
      }
    },
    "ai.highQuality": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جودة عالية (طلبان)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High quality (2 requests)"
          }
        }
      }
    },
    "ai.highQuality.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسم التطبيق النتيجة ويرسلها مع صورتك ليصحّح النموذج الفروق مرة واحدة. النتيجة أدق، لكنها تستهلك طلبين وتستغرق وقتًا أطول. مفعّل افتراضيًا مع المفاتيح المدفوعة، ومتوقف مع Gemini لأن حدود المفتاح المجاني ضيقة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app draws the result and sends it with your image so the model fixes the differences once. More accurate, but it uses two requests and takes longer. On by default for paid keys, off for Gemini because free keys have tight limits."
          }
        }
      }
    },
    "ai.key.delete": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف المفتاح"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete key"
          }
        }
      }
    },
    "ai.key.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ المفتاح في سلسلة المفاتيح على هذا الجهاز فقط، ولا يُنسخ احتياطيًا ولا يُزامن."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key is kept in this device's Keychain only. It is never backed up or synced."
          }
        }
      }
    },
    "ai.key.gemini.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح Gemini المجاني من Google AI Studio يكفي، ويسمح بنحو ٢٠ طلبًا في اليوم لكل نموذج. يبدأ المفتاح بـ AIza أو AQ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A free Gemini key from Google AI Studio is enough; it allows about 20 requests a day per model. Keys start with AIza or AQ."
          }
        }
      }
    },
    "ai.key.get": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على مفتاح"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a key"
          }
        }
      }
    },
    "ai.key.hide": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء المفتاح"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide key"
          }
        }
      }
    },
    "ai.key.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق المفتاح هنا"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste your key here"
          }
        }
      }
    },
    "ai.key.save": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حفظ المفتاح"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save key"
          }
        }
      }
    },
    "ai.key.saved": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المفتاح المحفوظ"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved key"
          }
        }
      }
    },
    "ai.key.show": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار المفتاح"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show key"
          }
        }
      }
    },
    "ai.key.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح API"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API key"
          }
        }
      }
    },
    "ai.key.warn.characters": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
