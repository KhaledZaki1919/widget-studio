    "detail.howTo.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على الشاشة الرئيسية ← + ← Widget Studio، ثم اسحب حتى تجد هذا القالب باسمه واضغط «إضافة الودجت»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-press the Home Screen → + → Widget Studio, then swipe to this template (by its name) and tap Add Widget."
          }
        }
      }
    },
