    "detail.howTo.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على الشاشة الرئيسية ← + ← Widget Studio ← اختر المقاس ← إضافة. ثم اضغط مطولًا على الودجت ← «تعديل الودجت» واختر هذا القالب."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-press the Home Screen → + → Widget Studio → pick a size → Add Widget. Then long-press the widget → Edit Widget and choose this template."
          }
        }
      }
    },
