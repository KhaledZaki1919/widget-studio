<?xml version="1.0" encoding="utf-8"?>
<!-- Extra large, 4×6 (ADR-030): xlarge designs; smaller ones scale in. Resizing redraws at the new size. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.khaled.widgetstudio.widget.ConfigureActivity"
    android:description="@string/widget_xlarge_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="390dp"
    android:minResizeWidth="60dp"
    android:minResizeHeight="60dp"
    android:previewImage="@drawable/preview_large"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="6"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
